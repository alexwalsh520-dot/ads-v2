# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill it in. .env.local is gitignored and
# must stay that way — every value below is a credential.
#
# In production these same names go into your host's environment variables
# (Vercel: Project → Settings → Environment Variables), NOT into a file.
#
# Run `npm run doctor` at any point to see exactly which of these are still
# missing and what each missing one costs you.
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED: the database ─────────────────────────────────────────────────
# Supabase → Project Settings → API.
# The service role key bypasses every access rule. It is server-only and must
# never appear in client code, a browser, or a screenshot.
# Looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── REQUIRED: sign-in ──────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application).
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://YOUR-DOMAIN/api/auth/callback/google          (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Your public URL. Local: http://localhost:3000
AUTH_URL=http://localhost:3000

# Comma-separated emails allowed in. This works with no database rows at all,
# which is what lets you sign in before anything else is set up.
ALLOWED_EMAILS=

# ── REQUIRED: scheduled jobs and webhooks ──────────────────────────────────
# Two independent secrets. Generate each with:  openssl rand -hex 32
# CRON_SECRET   authorises the scheduled sync.
# WEBHOOK_SECRET authorises ManyChat and your booking CRM.
CRON_SECRET=
WEBHOOK_SECRET=

# ── REQUIRED: Meta, one pair per creator ───────────────────────────────────
# The names here must match `adAccountEnv` and `tokenEnv` in adsv2.config.json.
# Use a System User token so it does not expire (see docs/SOP.md).
# META_AD_ACCOUNT_EXAMPLE=act_123456789
# META_ACCESS_TOKEN_EXAMPLE=

# ── OPTIONAL: the sales sheet (no revenue and no ROAS without it) ──────────
# Google Cloud Console → Credentials → API key, with the Google Sheets API
# enabled. The sheet must be shared as "anyone with the link can view".
# This app only ever READS your sheet.
# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=
