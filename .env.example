# ═══════════════════════════════════════════════════════════════════════════
# YOUR SETTINGS
#
# Copy this file to .env.local, then fill it in. .env.local is never uploaded
# to GitHub and must stay that way — everything below is a password of some
# kind.
#
# You should not have to fill most of this in by hand. `npm run setup` writes
# the random ones, and `npm run db` writes the database ones for you.
#
# Run `npm run doctor` any time to see what is still missing and why it matters.
# ═══════════════════════════════════════════════════════════════════════════

# ── YOUR PASSWORD ──────────────────────────────────────────────────────────
# This is what you type to open your dashboard. Pick something only you know.
# Change it here and everyone signed in gets signed out. That is the point.
APP_PASSWORD=

# Used to sign your sign-in cookie. Generated for you by `npm run setup`.
# Never share it and never reuse it anywhere else.
AUTH_SECRET=

# The address of your dashboard once it is online. `npm run deploy` fills it in.
AUTH_URL=http://localhost:3000

# ── THE DATABASE ───────────────────────────────────────────────────────────
# `npm run db` creates the project and fills these three in for you.
# It needs a Supabase access token, which you make once at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── META (your ads) ────────────────────────────────────────────────────────
# Your ad account id from Ads Manager, and an access token.
# Use a System User token so it never expires. The setup guide walks you
# through making one.
META_AD_ACCOUNT=
META_ACCESS_TOKEN=

# ── SECURITY FOR THE AUTOMATIC PARTS ───────────────────────────────────────
# Both generated for you by `npm run setup`.
# CRON_SECRET    lets the hourly update run.
# WEBHOOK_SECRET goes on the end of your ManyChat and booking webhook links.
CRON_SECRET=
WEBHOOK_SECRET=

# ── YOUR SALES TRACKER (this is where revenue and ROAS come from) ──────────
# EASIEST WAY: share your Google Sheet as "anyone with the link can view",
# then paste the normal link from your browser's address bar here.
SHEET_URL=

# Only if you would rather not share the sheet by link. Needs a Google Cloud
# API key with the Google Sheets API turned on.
# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_SPREADSHEET_ID=

# ── PUTTING IT ONLINE ──────────────────────────────────────────────────────
# Made once at https://vercel.com/account/tokens. Used by `npm run deploy`.
VERCEL_TOKEN=
